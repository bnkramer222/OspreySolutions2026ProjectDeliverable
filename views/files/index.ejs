<%#
  VIEW - Survey files (Brandon)
  Upload a pre- or post-survey file, see every file and its import status.
  Data from fileController: title, basePath, current ('all'|'pre'|'post'),
  sections = [{ type, label, files }], programs, years, labels, aiUsage,
  success, error
%>
<%- include('../partials/header') %>
<div class="page">
  <div class="page-head">
    <div>
      <div class="eyebrow">File Management</div>
      <h1>Survey files</h1>
      <p>Upload pre- and post-survey results as CSV or Excel. The data scrubber cleans each file and shows you every change before anything is saved.</p>
    </div>
  </div>

  <nav class="tabs" aria-label="Survey sections">
    <a href="/files" <%- current === 'all' ? 'aria-current="page"' : '' %>>All files</a>
    <a href="/files/pre" <%- current === 'pre' ? 'aria-current="page"' : '' %>>Pre-Survey</a>
    <a href="/files/post" <%- current === 'post' ? 'aria-current="page"' : '' %>>Post-Survey</a>
  </nav>

  <% if (success) { %><div class="alert alert-ok" role="status"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>

  <%# ---- Upload (story #5 + tags from story #41) ----
      The form's action is set by the Pre/Post choice. The tag fields come
      BEFORE the file input so the server can check them first. %>
  <section class="card">
    <div class="card-head">
      <div><h2>Upload a survey file</h2><p>Tags fill in anything the file leaves out, like the site or cohort. A seminar or community group works the same as a school.</p></div>
      <span class="small muted" title="AI suggestions use Groq's free tier">
        <% if (aiUsage.enabled) { %>AI suggestions on · <%= aiUsage.requests %> request<%= aiUsage.requests === 1 ? '' : 's' %> today<% } else { %>AI suggestions off (no GROQ_API_KEY). Rules still clean the file.<% } %>
      </span>
    </div>
    <form id="upload-form" class="dropzone" action="/files/upload" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="returnTo" value="<%= basePath %>">
      <div class="form-grid">
        <fieldset class="field span-2" style="border:0;padding:0;margin:0">
          <legend style="padding:0;margin-bottom:6px">Pre or post survey?</legend>
          <div class="row">
            <label class="check"><input type="radio" name="survey" value="auto" checked> Detect automatically</label>
            <label class="check"><input type="radio" name="survey" value="pre"> Pre</label>
            <label class="check"><input type="radio" name="survey" value="post"> Post</label>
          </div>
          <span class="hint">Reads the file name, sheet name, title and columns. If it can't tell, you choose on the next page.</span>
        </fieldset>
        <label class="field">Program *
          <select name="program" required>
            <option value="">Choose…</option>
            <% programs.forEach((p) => { %><option><%= p %></option><% }) %>
          </select>
        </label>
        <label class="field">School / site *
          <input type="text" name="school" maxlength="120" placeholder="e.g. Lincoln High School, Money Moves Seminar" required>
        </label>
        <label class="field">Site type
          <select name="site_type">
            <option value="">Work it out from the name</option>
            <% siteTypes.forEach((t) => { %><option><%= t %></option><% }) %>
          </select>
        </label>
        <label class="field">Cohort
          <input type="text" name="cohort" maxlength="60" placeholder="e.g. Fall 2026">
        </label>
        <label class="field">Academic year
          <select name="year">
            <option value="">—</option>
            <% years.forEach((y) => { %><option><%= y %></option><% }) %>
          </select>
        </label>
        <label class="field span-2">Survey file (CSV or Excel .xlsx, up to 4 MB) *
          <input type="file" name="surveyFile" accept=".csv,.xlsx" required>
        </label>
        <button class="btn" type="submit">Upload &amp; check</button>
      </div>
    </form>
  </section>

  <% sections.forEach(({ type, label, files }) => { %>
    <section class="card card-flush">
      <div class="card-head">
        <h2><%= label %> <span class="muted small">· <%= files.length %> <%= files.length === 1 ? 'file' : 'files' %></span></h2>
      </div>
      <% if (files.length === 0) { %>
        <div class="empty"><strong>No <%= label.toLowerCase() %> files yet</strong>Upload one above to get started.</div>
      <% } else { %>
        <div class="table-wrap">
          <table class="table">
            <thead><tr><th>File</th><th>Status</th><th>Program</th><th>School / site</th><th>Cohort</th><th>Year</th><th>Uploaded</th><th><span class="sr-only">Actions</span></th></tr></thead>
            <tbody>
              <% files.forEach((f) => {
                   const fileUrl = '/files/' + type + '/' + encodeURIComponent(f.name);
                   const sizeText = (f.size / 1024).toFixed(1) + ' KB'; %>
                <tr>
                  <td><strong><%= f.name %></strong><div class="tiny muted"><%= sizeText %></div></td>
                  <td>
                    <% if (f.waiting) { %><span class="badge badge-review">Needs review</span>
                    <% } else if (f.status === 'imported') { %><span class="badge badge-ok"><%= f.rowCount %> responses</span>
                    <% } else { %><span class="badge badge-warn">Not imported</span><% } %>
                  </td>
                  <td><%= f.program || '—' %></td>
                  <td><%= f.school || '—' %><% if (f.siteType) { %><div class="tiny muted"><%= f.siteType %></div><% } %></td>
                  <td><%= f.cohort || '—' %></td>
                  <td><%= f.year || '—' %></td>
                  <td class="nowrap small"><%= f.uploadedAt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                  <td>
                    <div class="table-actions">
                      <% if (f.waiting) { %>
                        <a class="btn btn-accent btn-sm" href="/files/review/<%= f.id %>">Review</a>
                      <% } else if (f.status !== 'imported') { %>
                        <form method="POST" action="/files/import/<%= f.id %>"><button class="btn btn-accent btn-sm" type="submit">Import rows</button></form>
                      <% } %>
                      <a class="btn btn-ghost btn-sm" href="<%= fileUrl %>">Download</a>
                      <button type="button" class="btn btn-ghost btn-sm" data-delete
                              data-action="<%= fileUrl %>/delete" data-name="<%= f.name %>"
                              data-meta="<%= [label, f.school, f.cohort, f.status === 'imported' ? f.rowCount + ' responses' : null].filter(Boolean).join(' · ') %>">Delete</button>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  <% }) %>
</div>

<%# STORY #17: "Delete this file?" pop-up. The user must type DELETE (the server checks too). %>
<dialog id="del" class="modal" aria-labelledby="del-title">
  <form id="del-form" method="POST">
    <h2 id="del-title">Delete this file?</h2>
    <div class="card" style="padding:12px;box-shadow:none"><strong id="del-name"></strong><div id="del-meta" class="small muted"></div></div>
    <p>The file and all of its survey responses will be permanently removed. Dashboard numbers and reports will no longer count them. This can't be undone.</p>
    <label class="field">Type DELETE to confirm<input id="del-input" type="text" name="confirmText" placeholder="DELETE" autocomplete="off" required></label>
    <input type="hidden" name="returnTo" value="<%= basePath %>">
    <div class="modal-buttons">
      <button type="button" class="btn btn-ghost" id="del-cancel">Cancel</button>
      <button type="submit" class="btn btn-danger" id="del-submit" disabled>Delete file</button>
    </div>
  </form>
</dialog>

<script>
  (function () {
    // Delete pop-up
    var dialog = document.getElementById('del'), delForm = document.getElementById('del-form');
    var input = document.getElementById('del-input'), submit = document.getElementById('del-submit');
    document.querySelectorAll('[data-delete]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        delForm.action = btn.dataset.action;
        document.getElementById('del-name').textContent = btn.dataset.name;
        document.getElementById('del-meta').textContent = btn.dataset.meta;
        input.value = ''; submit.disabled = true; dialog.showModal(); input.focus();
      });
    });
    input.addEventListener('input', function () { submit.disabled = input.value.trim() !== 'DELETE'; });
    document.getElementById('del-cancel').addEventListener('click', function () { dialog.close(); });
  })();
</script>
<%- include('../partials/footer') %>
