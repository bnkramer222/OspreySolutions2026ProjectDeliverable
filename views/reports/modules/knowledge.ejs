<% const series = [{ name: 'Pre-survey', color: 'var(--pre)' }, { name: 'Post-survey', color: 'var(--post)' }]; %>
<% if (!s.scales.length && !s.scores.length) { %><p class="muted">No rating or score questions in this data.</p><% } %>
<% if (s.scales.length) { %>
  <h3 style="margin-bottom:8px">Average rating (1–5)</h3>
  <%- include('../partials/bars', { series, max: 5, ticks: [0, 1, 2, 3, 4, 5], tickText: (t) => t, ariaLabel: 'Average ratings before and after',
        items: s.scales.map((i) => ({ label: i.q.label, values: [i.pre, i.post], text: [fmt.num(i.pre), fmt.num(i.post)] })) }) %>
<% } %>
<% if (s.scores.length) { %>
  <h3 style="margin:18px 0 8px">Scores</h3>
  <%- include('../partials/bars', { series, max: 100, ticks: [0, 25, 50, 75, 100], tickText: (t) => t + '%', ariaLabel: 'Scores before and after',
        items: s.scores.map((i) => ({ label: i.q.label, values: [i.pre, i.post], text: [fmt.value(i.q, i.pre), fmt.value(i.q, i.post)] })) }) %>
<% } %>
<% if (s.table.rows.length) { %>
  <details style="margin-top:14px"><summary class="small" style="cursor:pointer;font-weight:600;color:var(--teal)">Show as table</summary>
    <div class="table-wrap" style="margin-top:8px"><table class="table">
      <thead><tr><% s.table.columns.forEach((c, i) => { %><th class="<%= i ? 'num' : '' %>"><%= c %></th><% }) %></tr></thead>
      <tbody><% s.table.rows.forEach((r) => { %><tr><% r.forEach((v, i) => { %><td class="<%= i ? 'num' : '' %>"><%= v %></td><% }) %></tr><% }) %></tbody>
    </table></div></details>
<% } %>
