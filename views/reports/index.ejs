<%#
  VIEW - Report builder (Joshua)
  Left: choose a template or sections, filters and options.
  Right: the report itself, ready to print / save as PDF or download as CSV.
  Each section is drawn by views/reports/modules/<view>.ejs.
  Data from reportController: request, report, filterDefs, filterOptions,
  templates, modules, filterText, exportUrl, fmt, generated
%>
<%- include('../partials/header') %>
<div class="page">
  <div class="page-head">
    <div>
      <div class="eyebrow">Report Generation</div>
      <h1>Reports</h1>
      <p>Combined results across every imported survey. Pick a ready-made report or build your own, then print, save as PDF, or download the numbers.</p>
    </div>
    <div class="page-actions">
      <a class="btn btn-ghost" href="<%= exportUrl %>">Download CSV</a>
      <button class="btn btn-accent" type="button" onclick="window.print()">Print / Save PDF</button>
    </div>
  </div>

  <div class="builder">
    <form class="builder-panel" id="builder" method="GET" action="/reports">
      <section class="card">
        <h3>Report</h3>
        <div class="template-list">
          <% templates.forEach((t) => { %>
            <label><input type="radio" name="template" value="<%= t.id %>" <%= request.template.id === t.id ? 'checked' : '' %> data-auto>
              <span><strong><%= t.title %></strong><br><span class="small muted"><%= t.description %></span></span></label>
          <% }) %>
        </div>
        <label class="field" style="margin-top:12px">Title on the report<input type="text" name="title" value="<%= request.title %>" maxlength="120"></label>
      </section>

      <section class="card">
        <h3>Sections</h3>
        <div class="module-list">
          <% modules.forEach((m) => { %>
            <label class="check"><input type="checkbox" name="modules" value="<%= m.id %>" <%= request.modules.includes(m.id) ? 'checked' : '' %> data-module>
              <span><strong><%= m.title %></strong><br><span class="small muted"><%= m.description %></span></span></label>
          <% }) %>
        </div>
      </section>

      <section class="card">
        <h3>Filters</h3>
        <div class="stack">
          <% filterDefs.forEach((f) => { %>
            <label class="field"><%= f.label %>
              <select name="<%= f.key %>" data-auto>
                <option value="">All</option>
                <% (filterOptions[f.key] || []).forEach((v) => { %><option <%= request.filters[f.key] === v ? 'selected' : '' %>><%= v %></option><% }) %>
              </select>
            </label>
          <% }) %>
          <div class="form-grid" style="grid-template-columns:1fr 1fr">
            <label class="field">Surveys from<input type="date" name="from" value="<%= request.filters.from || '' %>" data-auto></label>
            <label class="field">to<input type="date" name="to" value="<%= request.filters.to || '' %>" data-auto></label>
          </div>
        </div>
      </section>

      <section class="card">
        <h3>Options</h3>
        <div class="stack">
          <label class="check"><input type="checkbox" name="matched" value="1" <%= request.options.matchedOnly ? 'checked' : '' %> data-auto>
            <span>Compare only students who took both surveys<br><span class="small muted">Recommended: a fair before/after comparison.</span></span></label>
          <input type="hidden" name="matched" value="0" disabled id="matched-off">
          <label class="field">Hide groups smaller than
            <select name="minGroup" data-auto>
              <% [1, 5, 10].forEach((n) => { %><option value="<%= n %>" <%= request.options.minGroup === n ? 'selected' : '' %>><%= n === 1 ? "Don't hide" : n + ' students' %></option><% }) %>
            </select>
            <span class="hint">Protects small classes in by-school and by-grade tables.</span>
          </label>
        </div>
      </section>
      <button class="btn" type="submit">Update report</button>
    </form>

    <%# ---------- The report ---------- %>
    <article class="report" aria-label="Report preview">
      <header class="report-cover">
        <div>
          <h1><%= request.title %></h1>
          <p>Planned to A.T., Inc. · Generated <%= generated %></p>
        </div>
        <img src="/images/ptat-logo-white.png" alt="Planned to A.T." onerror="if(!this.dataset.f){this.dataset.f=1;this.src='https://irp.cdn-website.com/77a9c324/dms3rep/multi/opt/WhiteLogo-211w.png'}else{this.remove()}">
      </header>
      <div class="report-filters"><strong>Data:</strong> <%= filterText %> · <%= report.counts.pre %> pre-survey and <%= report.counts.post %> post-survey responses</div>
      <div class="report-body">
        <% if (!report.counts.pre && !report.counts.post) { %>
          <div class="empty" style="padding:48px 0"><strong>No survey data matches these filters</strong>
            <% if (Object.keys(request.filters).length) { %>Try clearing a filter.<% } else { %>Import a pre- and post-survey file on the <a href="/files">Survey files</a> page first.<% } %></div>
        <% } else { report.sections.forEach((s) => { %>
          <section class="module" id="<%= s.id %>">
            <div class="module-head"><h2><%= s.title %></h2><p><%= s.description %></p></div>
            <%- include('modules/' + s.view, { s, fmt }) %>
          </section>
        <% }) } %>
      </div>
    </article>
  </div>
</div>
<script>
  (function () {
    var form = document.getElementById('builder');
    // Changing a template, filter or option updates the report right away
    form.querySelectorAll('[data-auto]').forEach(function (el) {
      el.addEventListener('change', function () {
        // An unticked checkbox sends nothing, so send matched=0 explicitly
        document.getElementById('matched-off').disabled = form.querySelector('input[name="matched"][type="checkbox"]').checked;
        form.submit();
      });
    });
    // Ticking a section by hand switches to "Custom"
    form.querySelectorAll('[data-module]').forEach(function (el) {
      el.addEventListener('change', function () {
        form.querySelector('input[name="template"][value="custom"]').checked = true;
        form.submit();
      });
    });
    form.addEventListener('submit', function () {
      document.getElementById('matched-off').disabled = form.querySelector('input[name="matched"][type="checkbox"]').checked;
    });
  })();
</script>
<%- include('../partials/footer') %>
