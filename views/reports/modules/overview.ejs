<div class="kpis">
  <% s.tiles.forEach((t) => { %>
    <div class="kpi"><div class="kpi-label"><%= t.label %></div><div class="kpi-value"><%= t.value %></div><div class="kpi-note"><%= t.note %></div></div>
  <% }) %>
</div>
<% if (s.byProgram.length > 1) { %>
  <div class="table-wrap" style="margin-top:16px"><table class="table">
    <% const hasGeneral = s.byProgram.some((p) => p.general); %>
    <thead><tr><th>Program</th><th class="num">Pre-survey students</th><th class="num">Post-survey students</th><% if (hasGeneral) { %><th class="num">General-survey students</th><% } %><th class="num">Schools / sites</th></tr></thead>
    <tbody><% s.byProgram.forEach((p) => { %><tr><td><%= p.program %></td><td class="num"><%= p.pre %></td><td class="num"><%= p.post %></td><% if (hasGeneral) { %><td class="num"><%= p.general %></td><% } %><td class="num"><%= p.schools %></td></tr><% }) %></tbody>
  </table></div>
<% } %>
