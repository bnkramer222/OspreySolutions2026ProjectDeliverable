<%# VIEW - Create Account (Victoria) %>
<%- include('../partials/header') %>
<link rel="stylesheet" href="/account.css">

<div class="auth-page">
  <form class="auth-card" action="/account/register" method="POST">
    <h1>Create Account</h1>
    <p class="auth-subtitle">For Planned to A.T. team members</p>

    <% if (error) { %>
      <p class="auth-error"><%= error %></p>
    <% } %>

    <label>Name
      <input type="text" name="name" value="<%= name %>" required autofocus>
    </label>

    <label>Email
      <input type="email" name="email" value="<%= email %>" required>
    </label>

    <label>Password
      <input type="password" name="password" minlength="8" required>
      <span class="auth-hint">At least 8 characters</span>
    </label>

    <button type="submit">Create Account</button>
    <p class="auth-switch">Already have an account? <a href="/account/login">Log in</a></p>
  </form>
</div>

<%- include('../partials/footer') %>