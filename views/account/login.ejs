<%# VIEW - Log In (Victoria) %>
<%- include('../partials/header') %>
<div class="auth-page">
  <form class="auth-card" action="/account/login" method="POST">
    <img class="auth-logo" src="/images/ptat-logo-gray.png" alt="" onerror="if(!this.dataset.f){this.dataset.f=1;this.src='https://irp.cdn-website.com/77a9c324/dms3rep/multi/opt/GrayLogo-185w.png'}else{this.remove()}">
    <h1>Welcome back</h1>
    <p class="auth-sub">Sign in to the Planned to A.T. Impact Platform</p>
    <% if (notice) { %><div class="alert alert-ok" role="status"><%= notice %></div><% } %>
    <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>
    <label class="field">Email<input type="email" name="email" value="<%= email %>" autocomplete="email" required autofocus></label>
    <label class="field">Password<input type="password" name="password" autocomplete="current-password" required></label>
    <button class="btn" type="submit">Sign in</button>
    <p class="auth-switch"><a href="/account/forgot">Forgot password?</a> · <a href="/account/register">Create an account</a></p>
  </form>
</div>
<%- include('../partials/footer') %>
