<%- include('../partials/header') %>
<h1>Files</h1>

<% [['pre', 'Pre-Survey', preFiles], ['post', 'Post-Survey', postFiles]].forEach(([type, label, files]) => { %>
  <section>
    <h2><%= label %></h2>

    <form action="/files/<%= type %>/upload" method="POST" enctype="multipart/form-data">
      <input type="file" name="surveyFile" accept=".csv,.xlsx,.xls" required>
      <button type="submit">Upload</button>
    </form>

    <% if (files.length === 0) { %>
      <p>No <%= label.toLowerCase() %> files uploaded yet.</p>
    <% } else { %>
      <ul>
        <% files.forEach((f) => { %>
          <li>
            <a href="/files/<%= type %>/<%= encodeURIComponent(f.name) %>" target="_blank"><%= f.name %></a>
            (<%= (f.size / 1024).toFixed(1) %> KB, <%= f.uploadedAt.toLocaleString() %>)
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
<% }) %>

<%- include('../partials/footer') %>