# Copy this file to .env for local development (never commit .env)

# Postgres connection string (Vercel + Neon set this automatically)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Any long random text; keeps sign-ins secure
SESSION_SECRET=change-me

# Optional: free AI help for the data scrubber (https://console.groq.com)
# Without it, the scrubber still cleans files using its rules.
GROQ_API_KEY=
# Optional: a different Groq model
# GROQ_MODEL=openai/gpt-oss-120b
