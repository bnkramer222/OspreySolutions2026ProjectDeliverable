<%- include('../partials/header') %>
<link rel="stylesheet" href="/account.css">
<div class="account-page">
  <h1>My Account</h1>
  <% if (notice) { %><p class="auth-success"><%= notice %></p><% } %>
  <% if (error) { %><p class="auth-error"><%= error %></p><% } %>
  <section class="auth-card wide profile-summary">
    <div class="profile-row"><div class="profile-avatar" role="img" aria-label="Profile initial"><span class="avatar-initial" aria-hidden="true"><%= (user.name || user.email || "A").trim().charAt(0).toUpperCase() %></span></div>
      <div><h2><%= user.name %></h2><p class="account-email"><%= user.email %></p></div></div>
    <p class="auth-subtitle">Manage your profile and security settings below.</p>
  </section>
  <details class="account-accordion" <%= error ? 'open' : '' %>>
    <summary><span class="accordion-heading"><span class="account-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5.5 20v-1.2a6.5 6.5 0 0 1 13 0V20"/></svg></span><span class="accordion-label"><strong>Profile Information</strong><small>View your name and email</small></span></span><span class="accordion-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <div class="accordion-content"><p><strong>Name:</strong> <%= user.name %></p><p><strong>Email:</strong> <%= user.email %></p></div>
  </details>
  <details class="account-accordion" <%= error ? 'open' : '' %>>
    <summary><span class="accordion-heading"><span class="account-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span><span class="accordion-label"><strong>Change Password</strong><small>Reset your password</small></span></span><span class="accordion-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <div class="accordion-content"><form class="account-form" action="/account/change-password" method="POST">
      <label>Current password<input type="password" name="currentPassword" required autocomplete="current-password"></label>
      <label>New password<input type="password" name="newPassword" minlength="8" required autocomplete="new-password"></label>
      <label>Confirm new password<input type="password" name="confirmPassword" minlength="8" required autocomplete="new-password"></label>
      <button type="submit">Update Password</button>
    </form></div>
  </details>
  <details class="account-accordion">
    <summary><span class="accordion-heading"><span class="account-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5"/><path d="m15 8 4 4-4 4M19 12H9"/></svg></span><span class="accordion-label"><strong>Sign Out</strong><small>Log out of your account</small></span></span><span class="accordion-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <div class="accordion-content"><p>Ready to leave your account?</p><form action="/account/logout" method="POST"><button type="submit">Sign Out</button></form></div>
  </details>
  <details class="account-accordion danger-accordion">
    <summary><span class="accordion-heading"><span class="account-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 4h4M6 7l1 14h10l1-14M10 11v6M14 11v6"/></svg></span><span class="accordion-label"><strong>Delete Account</strong><small>Remove your account from the system</small></span></span><span class="accordion-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <div class="accordion-content"><p>Deleting your account permanently removes your user record. This cannot be undone.</p>
      <form class="account-form" action="/account/delete" method="POST" onsubmit="return confirm('Permanently delete your account?');">
        <label>Confirm your password<input type="password" name="password" required autocomplete="current-password"></label>
        <button class="danger-button" type="submit">Delete My Account</button>
      </form></div>
  </details>
  <details class="account-accordion">
    <summary><span class="accordion-heading"><span class="account-icon"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <circle cx="12" cy="7" r="3.2"/>
  <circle cx="4.5" cy="9" r="2.4"/>
  <circle cx="19.5" cy="9" r="2.4"/>
  <path d="M12 12c-4 0-7 2.5-7 6v2h14v-2c0-3.5-3-6-7-6z"/>
  <path d="M4.5 13C2 13 0 15 0 17v2h4v-1c0-2 1-3.5 2-4.5-.5-.3-1-.5-1.5-.5z"/>
  <path d="M19.5 13c2.5 0 4.5 2 4.5 4v2h-4v-1c0-2-1-3.5-2-4.5.5-.3 1-.5 1.5-.5z"/>
</svg></span><span class="accordion-label"><strong>Admin Accounts</strong><small>View all admin profiles</small></span></span><span class="accordion-arrow" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m6 9 6 6 6-6"/></svg></span></summary>
    <div class="accordion-content"><ul class="account-list"><% accounts.forEach((a) => { %><li><strong><%= a.name %></strong><span><%= a.email %></span></li><% }) %></ul></div>
  </details>
</div><%- include('../partials/footer') %>
