<%# VIEW - Create Account (Victoria) %>
<%- include('../partials/header') %>
<div class="auth-page">
  <form class="auth-card" action="/account/register" method="POST">
    <h1>Create an account</h1>
    <p class="auth-sub">For Planned to A.T. staff. A staff member approves new accounts before they can sign in.</p>
    <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>
    <div class="form-grid">
      <label class="field">First name<input type="text" name="firstName" value="<%= firstName %>" autocomplete="given-name" required autofocus></label>
      <label class="field">Last name<input type="text" name="lastName" value="<%= lastName %>" autocomplete="family-name" required></label>
    </div>
    <label class="field">Email<input type="email" name="email" value="<%= email %>" autocomplete="email" required></label>
    <label class="field">Password<input type="password" name="password" minlength="8" autocomplete="new-password" required><span class="hint">At least 8 characters</span></label>
    <button class="btn" type="submit">Create account</button>
    <p class="auth-switch">Already have an account? <a href="/account/login">Sign in</a></p>
  </form>
</div>
<%- include('../partials/footer') %>
