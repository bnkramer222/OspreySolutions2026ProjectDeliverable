<%- include('../partials/header') %>
<link rel="stylesheet" href="/account.css">
<div class="auth-page"><section class="auth-card">
  <div class="feature-icon">🔐</div><h1>Forgot Password?</h1>
  <p class="auth-subtitle">Enter your account details and choose a new password.</p>
  <% if (error) { %><p class="auth-error"><%= error %></p><% } %>
  <form class="account-form" action="/account/forgot" method="POST">
    <label>Account email<input type="email" name="email" value="<%= email %>" required autocomplete="email"></label>
    <label>First name<input type="text" name="firstName" value="<%= firstName || '' %>" required autocomplete="given-name"></label>
    <label>Last name<input type="text" name="lastName" value="<%= lastName || '' %>" required autocomplete="family-name"></label>
    <label>New password<input type="password" name="password" minlength="8" required autocomplete="new-password"></label>
    <label>Confirm new password<input type="password" name="confirmPassword" minlength="8" required autocomplete="new-password"></label>
    <button type="submit">Confirm Password Reset →</button>
  </form>
  <p class="auth-switch"><a href="/account/login">← Back to sign in</a></p>
</section></div><%- include('../partials/footer') %>
