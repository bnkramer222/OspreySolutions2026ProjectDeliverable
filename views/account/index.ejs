<%# VIEW - My Account (Victoria) %>
<%- include('../partials/header') %>
<div class="page page-narrow">
  <div class="page-head">
    <div class="row">
      <span class="avatar" style="width:56px;height:56px;font-size:22px" aria-hidden="true"><%= (user.firstName || user.name || '?').charAt(0).toUpperCase() %></span>
      <div><h1><%= user.name %></h1><p><%= user.email %></p></div>
    </div>
  </div>
  <% if (notice) { %><div class="alert alert-ok" role="status"><%= notice %></div><% } %>
  <% if (error) { %><div class="alert alert-err" role="alert"><%= error %></div><% } %>

  <% if (pending.length) { %>
    <section class="card" style="border-left:6px solid var(--yellow)">
      <div class="card-head"><div><h2>Waiting for approval</h2><p>Only approve people from Planned to A.T. or your team. Approved accounts can see all survey data.</p></div></div>
      <ul class="stack" style="list-style:none;padding:0;margin:0">
        <% pending.forEach((a) => { %>
          <li class="row" style="justify-content:space-between">
            <div class="row"><span class="avatar" aria-hidden="true"><%= (a.firstName || a.name).charAt(0).toUpperCase() %></span>
              <div><strong><%= a.name %></strong><div class="small muted"><%= a.email %> · signed up <%= new Date(a.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></div></div></div>
            <div class="row">
              <form method="POST" action="/account/approve/<%= a.id %>"><button class="btn btn-sm" type="submit">Approve</button></form>
              <form method="POST" action="/account/deny/<%= a.id %>" onsubmit="return confirm('Remove this sign-up request?');"><button class="btn btn-ghost btn-sm" type="submit">Deny</button></form>
            </div>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>

  <div class="grid grid-2">
    <section class="card">
      <div class="card-head"><div><h2>Change password</h2><p>You'll sign in again afterwards.</p></div></div>
      <form class="stack" action="/account/change-password" method="POST">
        <label class="field">Current password<input type="password" name="currentPassword" required autocomplete="current-password"></label>
        <label class="field">New password<input type="password" name="newPassword" minlength="8" required autocomplete="new-password"></label>
        <label class="field">Confirm new password<input type="password" name="confirmPassword" minlength="8" required autocomplete="new-password"></label>
        <div><button class="btn" type="submit">Update password</button></div>
      </form>
    </section>

    <section class="card">
      <div class="card-head"><div><h2>Staff accounts</h2><p><%= accounts.length %> people can sign in.</p></div></div>
      <ul class="stack" style="list-style:none;padding:0;margin:0">
        <% accounts.forEach((a) => { %>
          <li class="row"><span class="avatar" aria-hidden="true"><%= (a.firstName || a.name).charAt(0).toUpperCase() %></span>
            <div><strong><%= a.name %></strong><div class="small muted"><%= a.email %></div></div></li>
        <% }) %>
      </ul>
    </section>
  </div>

  <section class="card" style="border-color:#efc9c6">
    <div class="card-head"><div><h2>Delete my account</h2><p>Permanently removes your sign-in. Uploaded survey data stays.</p></div></div>
    <form class="row" action="/account/delete" method="POST" onsubmit="return confirm('Permanently delete your account? This cannot be undone.');">
      <label class="field" style="flex:1;min-width:220px">Confirm your password<input type="password" name="password" required autocomplete="current-password"></label>
      <button class="btn btn-danger" type="submit" style="align-self:flex-end">Delete account</button>
    </form>
  </section>
</div>
<%- include('../partials/footer') %>
